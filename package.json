{
  "name": "@eleno/pi-codemode-tool-catalog",
  "type": "module",
  "version": "0.1.1",
  "description": "Configurable tool catalog exposure and prioritization for Pi Codemode.",
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elenoxe/pi-codemode-tool-catalog.git"
  },
  "homepage": "https://github.com/Elenoxe/pi-codemode-tool-catalog#readme",
  "bugs": {
    "url": "https://github.com/Elenoxe/pi-codemode-tool-catalog/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codemode",
    "tool-catalog",
    "tool-exposure"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pi -e ./src/index.ts",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "prepare": "node .husky/install.mjs",
    "prepublishOnly": "bun run test && bun run check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxlint": "^1.83.0",
    "prettier": "3.9.8",
    "typebox": "1.3.27",
    "typescript": "^7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "prettier --write --ignore-unknown",
      "oxlint --fix"
    ],
    "*.{json,jsonc,yml,yaml,md}": "prettier --write --ignore-unknown"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.2.0"
  }
}
